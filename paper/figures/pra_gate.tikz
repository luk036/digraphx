\providecommand{\myff}[3]{%
  \node[draw, fill=yellow!20, minimum width=0.75cm, minimum height=0.75cm, inner sep=1pt] (#1) at (#2,#3) {};
  \node[font=\tiny, anchor=north west, inner sep=1pt] at (#1.north west) {D};
  \node[font=\tiny, anchor=north east, inner sep=1pt] at (#1.north east) {Q};
  \draw[line width=0.5pt] ($(#1.south west)+(0.05,0.05)$) -- ++(0.13,0) -- ++(-0.13,0.13);
}
\begin{tikzpicture}[circuit logic US, scale=0.95, transform shape, >=latex, every node/.style={font=\tiny},
   sp/.style={draw=red!80!black,thick}, hp/.style={draw=blue!80!black,thick}, sh/.style={draw=violet,thick}]

% (a) direct connection
\begin{scope}
  \myff{ai}{0}{0}\node[anchor=north] at (ai.south){FF$_i$};
  \myff{aj}{7}{0}\node[anchor=north] at (aj.south){FF$_j$};
  \draw[->] (ai.east)--(aj.west);
  \node[red,font=\large] at (3.5,0.4){$\times$};
  \node at (3.5,-0.9){\textbf{(a)} direct: no insertable logic};
\end{scope}

% (b) independent / disjoint
\begin{scope}[shift={(10.5,0)}]
  \myff{bi}{0}{0}\node[anchor=north] at (bi.south){FF$_i$};
  \myff{bj}{7}{0}\node[anchor=north] at (bj.south){FF$_j$};
  \node[and gate US,draw=red!80!black] (b1) at (2.0,1.5){};
  \node[or gate US,draw=red!80!black,logic gate inputs=nn] (b2) at (4.0,1.5){};
  \node[buffer gate US,draw=blue!80!black] (b4) at (3.5,-1.5){};
  \draw[->,sp] (0.4,0)--(0.9,0)--(0.9,1.5)--(b1.west);
  \draw[->,sp] (b1.east)--(b2.west);
  \draw[->,sp] (b2.east)--(6.1,1.5)--(6.1,0)--(6.6,0);
  \draw[->,hp] (0.4,0)--(0.9,0)--(0.9,-1.5)--(b4.west);
  \draw[->,hp] (b4.east)--(6.1,-1.5)--(6.1,0)--(6.6,0);
  \node[red!80!black,anchor=west] at (1.0,2.05){setup (max)};
  \node[blue!80!black,anchor=west] at (1.0,-2.05){hold (min)};
  \draw[red,dashed] ($(b4.east)+(0.4,-0.45)$) rectangle ($(b4.east)+(1.5,0.45)$);
  \node[red,font=\tiny,anchor=north] at (4.9,-2.0){insert $p_h$ only};
  \node at (3.5,-2.75){\textbf{(b)} independent: max/min disjoint};
\end{scope}

% (c) shared segment
\begin{scope}[shift={(0,-6.2)}]
  \myff{ci}{0}{0}\node[anchor=north] at (ci.south){FF$_i$};
  \myff{cj}{7}{0}\node[anchor=north] at (cj.south){FF$_j$};
  \node[and gate US,draw=violet] (c1) at (2.2,0){};
  \node[or gate US,draw=violet,logic gate inputs=nn] (c2) at (4.4,0){};
  \draw[->,sh] (0.4,0)--(c1.west);
  \draw[->,sh] (c1.east)--(c2.west);
  \draw[->,sh] (c2.east)--(6.6,0);
  \node[violet,anchor=south] at (3.3,0.55){setup $=$ hold};
  \draw[red,dashed] ($(3.3,0)+(-0.35,-0.45)$) rectangle ($(3.3,0)+(0.35,0.45)$);
  \node[red,font=\tiny,anchor=north] at (3.3,-0.55){insert: $p_s=p_h$};
  \node at (3.5,-1.5){\textbf{(c)} shared segment: one path carries both};
\end{scope}

% (d) hierarchical containment
\begin{scope}[shift={(10.5,-6.2)}]
  \myff{di}{0}{0}\node[anchor=north] at (di.south){FF$_i$};
  \myff{dj}{7}{0}\node[anchor=north] at (dj.south){FF$_j$};
  \node[and gate US,draw=violet] (d1) at (1.7,0){};
  \node[or gate US,draw=violet,logic gate inputs=nn] (d2) at (3.5,0){};
  \node[and gate US,draw=red!80!black] (d3) at (5.3,0){};
  \draw[->,sh] (0.4,0)--(d1.west);
  \draw[->,sh] (d1.east)--(d2.west);
  \draw[->,hp] (d2.south)--(3.5,-1.1)--(6.6,-1.1)--(6.6,0);
  \draw[->,sp] (d2.east)--(d3.west);
  \draw[->,sp] (d3.east)--(6.6,0);
  \node[violet,anchor=south] at (2.6,0.55){shared core};
  \node[red!80!black,anchor=south] at (5.3,0.55){setup-only};
  \draw[red,dashed] ($(2.6,0)+(-0.45,-0.45)$) rectangle ($(2.6,0)+(0.45,0.45)$);
  \draw[red,dashed] ($(d3)+(-0.35,-0.45)$) rectangle ($(d3)+(0.35,0.45)$);
  \node[red,font=\tiny,anchor=north] at (2.6,-0.5){insert: both};
  \node[red,font=\tiny,anchor=north] at (5.3,-1.7){insert: setup};
  \node at (3.5,-2.4){\textbf{(d)} containment: hold $\subset$ setup ($p_s\ge p_h$)};
\end{scope}
\end{tikzpicture}
